+  // B04: if Google sign-in bounces back with an error in the URL (e.g. the provider is not enabled),
+  // tell the user instead of silently reloading the sign-in page.
+  useEffect(() => {
+    const h = new URLSearchParams(window.location.hash.replace(/^#/, ""));
+    if (!h.get("error")) return;
+    const desc = (h.get("error_description") || "").replace(/\+/g, " ");
+    toast.error(/not supported|not enabled/i.test(decodeURIComponent(desc))
+      ? "Google sign-in is not available right now. Please use your mobile number or email."
+      : "Google sign-in did not finish. Please try again or use your mobile number.");
+    window.history.replaceState(null, "", window.location.pathname + window.location.search);
+  }, []);
