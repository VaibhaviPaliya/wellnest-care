       <Button variant="care" size="care" className="btn btn-primary mt-5 w-full" disabled={busy || !items.every(([k]) => ok[k])} onClick={onAccept}>{role === "senior" ? "I agree — continue" : busy ? "Creating account…" : "I agree — create account"}</Button>
